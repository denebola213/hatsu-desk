#!/usr/bin/env bash
# git が push の直前に呼ぶ。stdin に "<local ref> <local sha> <remote ref> <remote sha>" が並ぶ。
#
# main / master への直接 push と、その削除を止める。
# これはガードレール。`--no-verify` か `-c core.hooksPath=/dev/null` で外せるが、
# 外してもサーバー側のブランチ保護が最終的に拒否する。
set -uo pipefail

rc=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main | refs/heads/master)
      echo "pre-push: $remote_ref への直接 push は禁止。ブランチを切って PR を作る。" >&2
      rc=1
      ;;
  esac
done

exit $rc
